# Copy to ".env" (never commit .env) and adjust. Docker Compose reads it automatically.

# Shared HMAC secret: Auth Service signs tokens, API Gateway validates them (>= 32 characters).
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars

# Database credentials (used by all databases and services)
DB_USERNAME=bookstore
DB_PASSWORD=bookstore
MYSQL_ROOT_PASSWORD=root

# Images (used by docker-compose.yml on the demo machine)
IMAGE_PREFIX=ghcr.io/patpoooot/online-bookstore
IMAGE_TAG=latest

# Host port of the API Gateway
GATEWAY_PORT=8080

# JavaFX client (when started outside Docker)
BOOKSTORE_GATEWAY_URL=http://localhost:8080
